# Copy to .env.qa for local runs (never commit .env.qa)
QA_BACKEND_DIR=../Loyalty-Backend-Code
QA_BASE_URL=https://your-staging-backend.onrender.com
QA_CORS_ORIGINS=https://staging-admin.example.com,https://staging-business.example.com

# Dedicated QA accounts on STAGING (never real users; one session per account)
QA_MERCHANT_A_ID=
QA_MERCHANT_A_PASS=
QA_MERCHANT_B_ID=
QA_MERCHANT_B_PASS=
QA_CUSTOMER_ID=
QA_CUSTOMER_PASS=
QA_ADMIN_ID=
QA_ADMIN_PASS=

# Optional: use an installed Chrome/Chromium instead of `npx playwright install chromium`
# QA_CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# QA_CHROMIUM_ARGS=--no-sandbox
