{
  "name": "@qa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QA platform API: organizations, clients, projects, environments, credentials vault, runs and issues",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dogfood": "tsx scripts/dogfood.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@qa/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.4",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.3",
    "typescript": "^5.6.3"
  }
}
