{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "qa.config.ts",
    "test/**/*.ts",
    "seed/**/*.ts"
  ],
  "exclude": [
    "test/fixture-api/**",
    "node_modules"
  ]
}