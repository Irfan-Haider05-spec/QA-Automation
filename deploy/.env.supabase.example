# QA platform: Supabase database + this server (API) + Cloudflare Pages (dashboard)
# Copy to .env and fill in every line. Never commit .env.

# ── Addresses ──────────────────────────────────────────────────────────────
# This server's address (DNS A record → this server's IP)
API_DOMAIN=api.qa.example.com
# Where the dashboard opens (Cloudflare Pages custom domain), no slash at the end
DASHBOARD_URL=https://qa.example.com

# ── Database (Supabase) ────────────────────────────────────────────────────
# Supabase → Connect → "Session pooler" shows host and project ref, e.g.
#   postgresql://postgres.abcdefghijkl:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Replace "postgres." with "qa_owner." / "qa_app." and use the passwords from supabase-roles.sql.
# Keep the ?sslmode=... part: it checks Supabase's certificate (certs/supabase-ca.crt).
MIGRATION_DATABASE_URL=postgresql://qa_owner.PROJECTREF:OWNER_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/certs/supabase-ca.crt
DATABASE_URL=postgresql://qa_app.PROJECTREF:APP_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/certs/supabase-ca.crt

# ── Secrets (generate each with the command shown, one by one) ─────────────
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -base64 32      ← back this up (password manager): it decrypts stored test-account passwords
VAULT_MASTER_KEY=
# openssl rand -hex 32          (hosted runner; also start it with --profile hosted)
RUNNER_TOKEN=

# ── Accounts ───────────────────────────────────────────────────────────────
# invite: first sign-up owns the platform, then invite-only. open: anyone can sign up.
SIGNUP_MODE=invite

# ── Email (Brevo / Resend / SendGrid SMTP) ─────────────────────────────────
# e.g. smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM=QA Platform <qa@example.com>

# ── Optional ───────────────────────────────────────────────────────────────
# Prometheus metrics at http://api:4100/metrics (openssl rand -hex 24)
METRICS_TOKEN=
