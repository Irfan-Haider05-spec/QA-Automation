# Copy to .env and fill in. Generate secrets with the commands shown.
# Never commit .env.

# Public domain of the platform (DNS A record → this server)
DOMAIN=qa.example.com

# Only for docker-compose.api.yml (dashboard on Cloudflare Pages / Vercel):
# API_DOMAIN = this server (DNS A record), DASHBOARD_URL = where the dashboard is served
API_DOMAIN=api.qa.example.com
DASHBOARD_URL=https://qa.example.com

# Who runs this platform, shown on the terms and privacy pages (have that text reviewed)
OPERATOR_NAME=MLITech
CONTACT_EMAIL=support@example.com

# Database passwords:  openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
QA_APP_PASSWORD=

# Login tokens:  openssl rand -hex 32
JWT_SECRET=
# Encrypts test-account passwords and webhook URLs. Back it up: without it they can't be read.
#   openssl rand -base64 32
VAULT_MASTER_KEY=

# Who can create accounts. invite (default): the first account you create, then
# only people you invite. open: anyone (for a public SaaS sign-up page).
SIGNUP_MODE=invite

# Hosted runs (optional; also start the runner: docker compose --profile hosted up -d)
#   openssl rand -hex 32
RUNNER_TOKEN=

# Prometheus metrics at http://api:4100/metrics inside the Docker network (optional)
#   openssl rand -hex 24
METRICS_TOKEN=

# Email: notifications, email confirmation, password reset (optional, but without it
# people can't reset a forgotten password themselves; the API log shows the link instead)
SMTP_URL=
MAIL_FROM=QA Platform <qa@example.com>
