# One-server stack behind Cloudflare's proxy (orange cloud), SSL/TLS mode "Full (strict)".
# Used by docker-compose.cloudflare.yml. See DIGITALOCEAN.md.
#
# Certificate: a Cloudflare Origin Certificate saved as certs/cloudflare-origin.pem and
# certs/cloudflare-origin.key (Cloudflare → SSL/TLS → Origin Server). It is trusted only by
# Cloudflare, so this server must stay behind the orange cloud; nothing renews here.
#
# trusted_proxies: Cloudflare's published ranges (https://www.cloudflare.com/ips/, last
# updated there on 2023-09-28). Requests from them keep their X-Forwarded-For, so the API
# sees the visitor's address for rate limits and audit logs, not Cloudflare's.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$DOMAIN} {
	tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin.key
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy dashboard:8080
}
